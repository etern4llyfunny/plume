#!/bin/sh
set -e

SELF_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if [ -n "${PLUME_ROOT:-}" ] && [ -d "$PLUME_ROOT/config" ]; then
  ROOT="$PLUME_ROOT"
elif [ -d "/usr/share/plume/config" ]; then
  ROOT="/usr/share/plume"
else
  ROOT="$SELF_DIR"
fi

if [ -x "$SELF_DIR/plume-launcher" ]; then
  export PATH="$SELF_DIR:$PATH"
fi

if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
  export PLUME_NESTED=1
else
  export PLUME_NESTED=0
fi

RT_DIR="${XDG_RUNTIME_DIR:-/tmp}/plume-$$"
mkdir -p "$RT_DIR/waybar" "$RT_DIR/wayfire" "$RT_DIR/mako" \
         "$RT_DIR/share/themes/Plume/gtk-3.0" "$RT_DIR/share/themes/Plume/gtk-4.0"

cleanup() {
  if [ -f "$RT_DIR/pids" ]; then
    while read -r pid; do
      kill "$pid" 2>/dev/null || true
    done < "$RT_DIR/pids"
  fi
  rm -rf "$RT_DIR"
}
trap cleanup EXIT INT TERM

XKB_LAYOUT=""
XKB_OPTIONS=""
for envf in "$HOME/.config/plume/keyboard.env" "/etc/environment"; do
  if [ -f "$envf" ]; then
    [ -z "$XKB_LAYOUT" ] && XKB_LAYOUT="$(sed -n 's/^XKB_DEFAULT_LAYOUT=//p' "$envf" | head -n 1 | tr -d '"'\'' ')"
    [ -z "$XKB_OPTIONS" ] && XKB_OPTIONS="$(sed -n 's/^XKB_DEFAULT_OPTIONS=//p' "$envf" | head -n 1 | tr -d '"'\'' ')"
  fi
done
[ -n "$XKB_LAYOUT" ] || XKB_LAYOUT="us,ru"
[ -n "$XKB_OPTIONS" ] || XKB_OPTIONS="grp:alt_shift_toggle"

MOUSE_CFG="$HOME/.config/plume/mouse.ini"
read_mouse_pref() {
  key="$1"
  fallback="$2"
  value=""
  if [ -f "$MOUSE_CFG" ]; then
    value="$(sed -n "s/^${key}=//p" "$MOUSE_CFG" | head -n 1 | tr -d ' ')"
  fi
  [ -n "$value" ] || value="$fallback"
  printf '%s' "$value"
}

MOUSE_CURSOR_SPEED="$(read_mouse_pref mouse_cursor_speed 0.0)"
MOUSE_SCROLL_SPEED="$(read_mouse_pref mouse_scroll_speed 1.0)"
TOUCHPAD_CURSOR_SPEED="$(read_mouse_pref touchpad_cursor_speed 0.0)"
TOUCHPAD_SCROLL_SPEED="$(read_mouse_pref touchpad_scroll_speed 1.0)"
NATURAL_SCROLL="$(read_mouse_pref natural_scroll false)"
TAP_TO_CLICK="$(read_mouse_pref tap_to_click true)"
DISABLE_TOUCHPAD_WHILE_TYPING="$(read_mouse_pref disable_touchpad_while_typing true)"

sed \
  -e "s|@XKB_LAYOUT@|$XKB_LAYOUT|g" \
  -e "s|@XKB_OPTIONS@|$XKB_OPTIONS|g" \
  -e "s|@MOUSE_CURSOR_SPEED@|$MOUSE_CURSOR_SPEED|g" \
  -e "s|@TOUCHPAD_CURSOR_SPEED@|$TOUCHPAD_CURSOR_SPEED|g" \
  -e "s|@NATURAL_SCROLL@|$NATURAL_SCROLL|g" \
  -e "s|@TAP_TO_CLICK@|$TAP_TO_CLICK|g" \
  -e "s|@DISABLE_TOUCHPAD_WHILE_TYPING@|$DISABLE_TOUCHPAD_WHILE_TYPING|g" \
  -e "s|@AUTOSTART@|$ROOT/config/wayfire/autostart|g" \
  "$ROOT/config/wayfire/wayfire.ini" > "$RT_DIR/wayfire/wayfire.ini"

set_input_option() {
  key="$1"
  value="$2"
  file="$RT_DIR/wayfire/wayfire.ini"
  if grep -q "^${key}[[:space:]]*=" "$file"; then
    sed -i -E "s|^${key}[[:space:]]*=.*$|${key} = ${value}|" "$file"
  else
    sed -i "/^\[input\]$/a ${key} = ${value}" "$file"
  fi
}
set_input_option mouse_scroll_speed "$MOUSE_SCROLL_SPEED"
set_input_option touchpad_scroll_speed "$TOUCHPAD_SCROLL_SPEED"

read_plume_pref() {
  file="$1"
  key="$2"
  fallback="$3"
  value=""
  if [ -f "$file" ]; then
    value="$(sed -n "s/^${key}=//p" "$file" | tail -n 1 | tr -d ' ')"
  fi
  [ -n "$value" ] || value="$fallback"
  printf '%s' "$value"
}

ACCESS_CFG="$HOME/.config/plume/accessibility.ini"
ACCESS_LARGE_TEXT="$(read_plume_pref "$ACCESS_CFG" large_text false)"
ACCESS_REDUCE_MOTION="$(read_plume_pref "$ACCESS_CFG" reduce_motion false)"
ACCESS_CURSOR_SIZE="$(read_plume_pref "$ACCESS_CFG" cursor_size 24)"
set_input_option cursor_size "$ACCESS_CURSOR_SIZE"
if [ "$ACCESS_REDUCE_MOTION" = "true" ]; then
  sed -i -E \
    -e 's|^duration[[:space:]]*=.*$|duration = 0ms linear|' \
    -e 's|^zoom_duration[[:space:]]*=.*$|zoom_duration = 0ms linear|' \
    -e 's|^fade_duration[[:space:]]*=.*$|fade_duration = 0ms linear|' \
    -e 's|^squeezimize_duration[[:space:]]*=.*$|squeezimize_duration = 0ms linear|' \
    "$RT_DIR/wayfire/wayfire.ini"
fi

sed -e "s|/usr/share/plume/assets/plume-logo-clean.svg|$RT_DIR/waybar/plume-logo.svg|g" -e "s|/usr/share/plume|$ROOT|g" "$ROOT/config/waybar/config.jsonc" > "$RT_DIR/waybar/config.jsonc"

export PLUME_ROOT="$ROOT"
export PLUME_RUNTIME="$RT_DIR"
export XDG_DATA_DIRS="$RT_DIR/share:$ROOT/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export XDG_CONFIG_DIRS="$ROOT/config:${XDG_CONFIG_DIRS:-/etc/xdg}"
export XDG_CURRENT_DESKTOP="Plume:wayfire:wlroots"
export XDG_SESSION_DESKTOP="Plume"
export DESKTOP_SESSION="plume"
export XDG_SESSION_TYPE="wayland"
# Let Wayfire draw the same window controls for regular GTK3/GTK4 windows.
# Applications with a custom headerbar retain their own controls by design.
export GTK_CSD=0
# Keep GTK button layout scoped to Plume, without changing GNOME's dconf.
export GSETTINGS_BACKEND=keyfile
if command -v gsettings >/dev/null 2>&1 &&
   gsettings list-schemas | grep -qx 'org.gnome.desktop.wm.preferences'; then
  gsettings set org.gnome.desktop.wm.preferences button-layout ':minimize,maximize,close' || true
fi
if command -v gsettings >/dev/null 2>&1 &&
   gsettings list-schemas | grep -qx 'org.gnome.desktop.interface'; then
  if [ "$ACCESS_LARGE_TEXT" = "true" ]; then
    gsettings set org.gnome.desktop.interface text-scaling-factor 1.25 || true
  else
    gsettings set org.gnome.desktop.interface text-scaling-factor 1.0 || true
  fi
  if [ "$ACCESS_REDUCE_MOTION" = "true" ]; then
    gsettings set org.gnome.desktop.interface enable-animations false || true
  else
    gsettings set org.gnome.desktop.interface enable-animations true || true
  fi
fi
export GTK_THEME="Plume"
export GSK_RENDERER="gl"
unset GDMSESSION GNOME_DESKTOP_SESSION_ID

plume-apply-theme --no-reload
plume-pinned apply-runtime "$RT_DIR"

wayfire -c "$RT_DIR/wayfire/wayfire.ini" &
WM_PID=$!
echo "$WM_PID" > "$RT_DIR/wm.pid"
wait "$WM_PID"
