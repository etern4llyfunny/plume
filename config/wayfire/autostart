#!/bin/sh
ROOT="${PLUME_ROOT:-/usr/share/plume}"
RT="${PLUME_RUNTIME:-$ROOT/config}"
PIDS="$RT/pids"

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  if [ "${PLUME_NESTED:-0}" != "1" ]; then
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE GTK_THEME GTK_CSD GSETTINGS_BACKEND XDG_DATA_DIRS 2>/dev/null || true
  elif [ "${PLUME_PRIVATE_DBUS:-0}" = "1" ]; then
    # The nested launcher provides its own bus; do not update GNOME's systemd environment.
    dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE GTK_THEME GTK_CSD GSETTINGS_BACKEND XDG_DATA_DIRS 2>/dev/null || true
  fi
fi

USER_WALL=""
if [ -f "$HOME/.config/plume/wallpaper" ]; then
  USER_WALL="$(cat "$HOME/.config/plume/wallpaper" 2>/dev/null || true)"
fi

WALL=""
for candidate in \
  "$USER_WALL" \
  "$ROOT/assets/wallpaper.png" \
  "/usr/share/backgrounds/ouvert-walp.png" \
  "/usr/share/pixmaps/ouvert-walp.png" \
  "$HOME/pzhavos/pkgbuilds/ouvert-branding/ouvert-walp.png"; do
  if [ -n "$candidate" ] && [ -f "$candidate" ]; then
    WALL="$candidate"
    break
  fi
done

if [ -n "$WALL" ]; then
  swaybg -i "$WALL" -m fill &
  echo $! >> "$PIDS"
else
  swaybg -c "#141821" &
  echo $! >> "$PIDS"
fi

GDK_BACKEND=wayland waybar -c "$RT/waybar/config.jsonc" -s "$RT/waybar/style.css" &
echo $! >> "$PIDS"

mako -c "$RT/mako/config" &
echo $! >> "$PIDS"

COLOR_CFG="$HOME/.config/plume/color.ini"
if [ -f "$COLOR_CFG" ] && command -v gammastep >/dev/null 2>&1; then
  COLOR_WARM="$(sed -n 's/^warm=//p' "$COLOR_CFG" | tail -n 1 | tr -d ' ')"
  COLOR_TEMPERATURE="$(sed -n 's/^temperature=//p' "$COLOR_CFG" | tail -n 1 | tr -d ' ')"
  [ -n "$COLOR_TEMPERATURE" ] || COLOR_TEMPERATURE=4500
  if [ "$COLOR_WARM" = "true" ]; then
    gammastep -P -O "$COLOR_TEMPERATURE" >/dev/null 2>&1 &
  fi
fi

if [ "${PLUME_NESTED:-0}" != "1" ]; then
  for agent in \
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
    /usr/libexec/polkit-gnome/polkit-gnome-authentication-agent-1; do
    if [ -x "$agent" ]; then
      "$agent" &
      echo $! >> "$PIDS"
      break
    fi
  done
fi

GDK_BACKEND=wayland plume-launcher --daemon &
echo $! >> "$PIDS"

GDK_BACKEND=wayland plume-power --daemon &
echo $! >> "$PIDS"

GDK_BACKEND=wayland plume-dock &
echo $! >> "$PIDS"
