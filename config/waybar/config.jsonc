{
  "layer": "top",
  "position": "top",
  "height": 40,
  "spacing": 4,
  "modules-left": [
    "image#plume",
    "custom/ws1",
    "custom/ws2",
    "custom/ws3",
    "custom/ws4",
    "custom/ws5"
  ],
  "modules-center": [],
  "modules-right": [
    "tray",
    "pulseaudio",
    "clock",
    "network",
    "battery",
    "custom/settings",
    "custom/power"
  ],
  "image#plume": {
    "path": "/usr/share/plume/assets/plume-logo-clean.svg",
    "size": 22,
    "on-click": "plume-launcher",
    "tooltip": false
  },
  "wlr/taskbar": {
    "format": "{title:.22}",
    "on-click": "activate",
    "tooltip": false
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "scroll-step": 5,
    "tooltip-format": "{desc} ({volume}%)"
  },
  "clock": {
    "format": "{:%d/%m/%Y  %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "on-click": "nm-connection-editor",
    "tooltip-format": "{ifname}: {ipaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-disconnected": "Нет подключения"
  },
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰁹"
    ]
  },
  "custom/settings": {
    "format": "󰒓",
    "on-click": "plume-settings",
    "tooltip": false
  },
  "custom/power": {
    "format": "󰐥",
    "on-click": "plume-power",
    "tooltip": false
  },
  "custom/ws1": {
    "exec": "plume-ws get 1",
    "return-type": "json",
    "signal": 8,
    "interval": 2,
    "on-click": "plume-ws set 1",
    "tooltip": false
  },
  "custom/ws2": {
    "exec": "plume-ws get 2",
    "return-type": "json",
    "signal": 8,
    "interval": 2,
    "on-click": "plume-ws set 2",
    "tooltip": false
  },
  "custom/ws3": {
    "exec": "plume-ws get 3",
    "return-type": "json",
    "signal": 8,
    "interval": 2,
    "on-click": "plume-ws set 3",
    "tooltip": false
  },
  "custom/ws4": {
    "exec": "plume-ws get 4",
    "return-type": "json",
    "signal": 8,
    "interval": 2,
    "on-click": "plume-ws set 4",
    "tooltip": false
  },
  "custom/ws5": {
    "exec": "plume-ws get 5",
    "return-type": "json",
    "signal": 8,
    "interval": 2,
    "on-click": "plume-ws set 5",
    "tooltip": false
  }
}
