{
  "layer": "top",
  "position": "top",
  "height": 40,
  "spacing": 4,
  "modules-left": ["image#plume", "ext/workspaces", "wlr/taskbar"],
  "modules-center": [],
  "modules-right": ["pulseaudio", "clock", "network", "battery", "custom/power"],

  "image#plume": {
    "path": "/home/admin/plume/assets/plume-logo-clean.svg",
    "size": 22,
    "on-click": "/home/admin/plume/plume-launcher",
    "tooltip": false
  },
  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "ignore-hidden": false
  },
  "wlr/taskbar": {
    "format": "{title:.22}",
    "on-click": "activate",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "scroll-step": 5,
    "tooltip-format": "{desc} ({volume}%)"
  },
  "clock": {
    "format": "{:%d/%m/%Y  %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname}: {ipaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-disconnected": "Нет подключения"
  },
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },
  "custom/power": {
    "format": "󰐥",
    "on-click": "/home/admin/plume/plume-power",
    "tooltip": false
  }
}
