<?xml version="1.0"?>
<labwc_config>
  <theme>
    <name>Plume</name>
    <cornerRadius>8</cornerRadius>
    <font name="Onest" size="10" />
  </theme>
  <desktops>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
      <name>5</name>
    </names>
  </desktops>
  <windowRules>
    <windowRule identifier="plume-launcher" serverDecoration="no" skipTaskbar="yes">
      <action name="MoveTo" x="8" y="40" />
    </windowRule>
    <windowRule identifier="plume-power" serverDecoration="no" skipTaskbar="yes">
      <action name="MoveToEdge" direction="up" />
      <action name="MoveToEdge" direction="right" />
    </windowRule>
  </windowRules>
  <keyboard>
    <default />
    <keybind key="W-Return">
      <action name="Execute" command="kitty" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="thunar" />
    </keybind>
    <keybind key="W-d">
      <action name="Execute" command="plume-launcher" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="plume-lock" />
    </keybind>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="C-W-Left">
      <action name="GoToDesktop" to="left" wrap="no" />
    </keybind>
    <keybind key="C-W-Right">
      <action name="GoToDesktop" to="right" wrap="no" />
    </keybind>
    <keybind key="Print">
      <action name="Execute" command="plume-screenshot full" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="plume-screenshot area" />
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="pactl set-sink-volume @DEFAULT_SINK@ +5%" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="pactl set-sink-volume @DEFAULT_SINK@ -5%" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="pactl set-sink-mute @DEFAULT_SINK@ toggle" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="brightnessctl set +5%" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="brightnessctl set 5%-" />
    </keybind>
  </keyboard>
  <mouse>
    <default />
    <context name="Desktop">
      <mousebind direction="Up" action="Scroll"><action name="None" /></mousebind>
      <mousebind direction="Down" action="Scroll"><action name="None" /></mousebind>
    </context>
  </mouse>
</labwc_config>
