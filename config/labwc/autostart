#!/bin/sh
ROOT="${PLUME_ROOT:-/usr/share/plume}"
RT="${PLUME_RUNTIME:-$ROOT/config}"
PIDS="$RT/pids"

if [ "${PLUME_NESTED:-0}" != "1" ] && command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE GTK_THEME 2>/dev/null || true
fi

USER_WALL=""
if [ -f "$HOME/.config/plume/wallpaper" ]; then
  USER_WALL="$(cat "$HOME/.config/plume/wallpaper" 2>/dev/null || true)"
fi
WALL=""
for candidate in \
  "$USER_WALL" \
  "$ROOT/assets/wallpaper.png" \
  "/usr/share/backgrounds/ouvert-walp.png" \
  "/usr/share/pixmaps/ouvert-walp.png" \
  "$HOME/pzhavos/pkgbuilds/ouvert-branding/ouvert-walp.png"; do
  if [ -n "$candidate" ] && [ -f "$candidate" ]; then
    WALL="$candidate"
    break
  fi
done

if [ -n "$WALL" ]; then
  swaybg -i "$WALL" -m fill &
  echo $! >> "$PIDS"
else
  swaybg -c "#141821" &
  echo $! >> "$PIDS"
fi

GDK_BACKEND=wayland waybar -c "$RT/waybar/config.jsonc" -s "$RT/waybar/style.css" &
echo $! >> "$PIDS"

mako -c "$ROOT/config/mako/config" &
echo $! >> "$PIDS"

if [ "${PLUME_NESTED:-0}" != "1" ]; then
  for agent in \
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
    /usr/libexec/polkit-gnome/polkit-gnome-authentication-agent-1; do
    if [ -x "$agent" ]; then
      "$agent" &
      echo $! >> "$PIDS"
      break
    fi
  done
fi

GDK_BACKEND=wayland plume-launcher --daemon &
echo $! >> "$PIDS"

GDK_BACKEND=wayland plume-power --daemon &
echo $! >> "$PIDS"
