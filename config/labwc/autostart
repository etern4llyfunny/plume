#!/bin/sh
if [ -f "$HOME/pzhavos/pkgbuilds/ouvert-branding/ouvert-walp.png" ]; then
  swaybg -i "$HOME/pzhavos/pkgbuilds/ouvert-branding/ouvert-walp.png" -m fill &
else
  swaybg -c "#141821" &
fi
waybar -c "$HOME/plume/config/waybar/config.jsonc" -s "$HOME/plume/config/waybar/style.css" &
mako -c "$HOME/plume/config/mako/config" &
"$HOME/plume/plume-launcher" --daemon &
"$HOME/plume/plume-power" --daemon &
