from pathlib import Path


def clamp(v: int) -> int:
    return max(0, min(255, v))


def parse_hex(c: str) -> tuple[int, int, int]:
    c = c.strip().lstrip("#")
    if len(c) != 6:
        return (47, 127, 230)
    try:
        return (int(c[0:2], 16), int(c[2:4], 16), int(c[4:6], 16))
    except ValueError:
        return (47, 127, 230)


def shift_hex(c: str, delta: int) -> str:
    r, g, b = parse_hex(c)
    return f"#{clamp(r + delta):02x}{clamp(g + delta):02x}{clamp(b + delta):02x}"


def load_theme() -> tuple[str, str]:
    mode = "dark"
    accent = "#2f7fe6"
    ini = Path.home() / ".config" / "plume" / "theme.ini"
    if ini.is_file():
        for line in ini.read_text(encoding="utf-8", errors="ignore").splitlines():
            if "=" not in line:
                continue
            k, v = line.split("=", 1)
            k, v = k.strip(), v.strip()
            if k == "mode" and v in ("dark", "light"):
                mode = v
            elif k == "accent" and re.fullmatch(r"#[0-9a-fA-F]{6}", v):
                accent = v.lower()
    return mode, accent


def palette(mode: str, accent: str) -> dict[str, str]:
    acc_hover = shift_hex(accent, 18 if mode == "dark" else -16)
    if mode == "light":
        return {
            "mode": "light",
            "bg": "#f3f5f9",
            "bg_alt": "#e8ecf3",
            "bg_hover": "#dce2ec",
            "border": "#cdd5e2",
            "border_strong": "#b8c3d4",
            "fg": "#171c26",
            "fg_dim": "#434d5e",
            "muted": "#667185",
            "accent": accent,
            "accent_hover": acc_hover,
            "wf_active": "#e8ecf3ff",
            "wf_inactive": "#dce2ecff",
            "wf_font": "#171c26ff",
            "wf_bg": "#e8ecf3ff",
            "gtk3_base": "resource:///org/gtk/libgtk/theme/Adwaita/gtk-contained.css",
            "gtk4_base": "resource:///org/gtk/libgtk/theme/Default/Default-light.css",
            "power_hover_bg": "#f8d8d5",
        }
    return {
        "mode": "dark",
        "bg": "#171a21",
        "bg_alt": "#13161c",
        "bg_hover": "#1c212b",
        "border": "#252b37",
        "border_strong": "#2b3342",
        "fg": "#edf0f5",
        "fg_dim": "#cfd5df",
        "muted": "#8b96a8",
        "accent": accent,
        "accent_hover": acc_hover,
        "wf_active": "#171a21ff",
        "wf_inactive": "#13161cff",
        "wf_font": "#edf0f5ff",
        "wf_bg": "#13161cff",
        "gtk3_base": "resource:///org/gtk/libgtk/theme/Adwaita/gtk-contained-dark.css",
        "gtk4_base": "resource:///org/gtk/libgtk/theme/Default/Default-dark.css",
        "power_hover_bg": "#2a1b1e",
    }


