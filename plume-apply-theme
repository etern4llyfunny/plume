def write_mako(rt: Path, p: dict[str, str]) -> None:
    d = rt / "mako"
    d.mkdir(parents=True, exist_ok=True)
    cfg = f"""font=Onest 10
background-color={p['bg']}
text-color={p['fg']}
border-color={p['accent']}
border-size=1
border-radius=8
padding=12
