default-timeout=5000
"""
    (d / "config").write_text(cfg, encoding="utf-8")


def _wf_rgba(val: str) -> str:
    s = val.strip()
    if not s.startswith("#"):
        return s
    h = s.lstrip("#")
    r = int(h[0:2], 16) / 255.0
    g = int(h[2:4], 16) / 255.0
    b = int(h[4:6], 16) / 255.0
    a = int(h[6:8], 16) / 255.0 if len(h) == 8 else 1.0
    return f"{r:.3f} {g:.3f} {b:.3f} {a:.3f}"


def update_wayfire(rt: Path, p: dict[str, str]) -> None:
    wf = rt / "wayfire" / "wayfire.ini"
    if not wf.is_file():
        return
    txt = wf.read_text(encoding="utf-8")
    subs = [
        (r"^active_color\s*=.*$", f"active_color = {_wf_rgba(p['wf_active'])}"),
        (r"^inactive_color\s*=.*$", f"inactive_color = {_wf_rgba(p['wf_inactive'])}"),
        (r"^font_color\s*=.*$", f"font_color = {_wf_rgba(p['wf_font'])}"),
        (r"^background_color\s*=.*$", f"background_color = {_wf_rgba(p['wf_bg'])}"),
    ]
    for pat, repl in subs:
        txt = re.sub(pat, repl, txt, flags=re.MULTILINE)
    wf.write_text(txt, encoding="utf-8")



def write_logo(rt: Path, mode: str) -> None:
    root = Path(os.environ.get("PLUME_ROOT") or "/usr/share/plume")
    src = root / "assets" / "plume-logo-clean.svg"
    if not src.is_file():
        return
    svg = src.read_text(encoding="utf-8")
    if mode == "light":
        svg = re.sub(r"#[0-9a-fA-F]{6}\b", "#1c212b", svg)
        svg = re.sub(r"#[0-9a-fA-F]{3}\b", "#1c212b", svg)
    d = rt / "waybar"
    d.mkdir(parents=True, exist_ok=True)
    (d / "plume-logo.svg").write_text(svg, encoding="utf-8")


def main() -> None:
    no_reload = "--no-reload" in sys.argv
    rt_env = os.environ.get("PLUME_RUNTIME")
    if not rt_env:
        return
    rt = Path(rt_env)
    mode, accent = load_theme()
    p = palette(mode, accent)

    write_logo(rt, mode)
    write_waybar_css(rt, p)
    write_gtk_themes(rt, p)
    write_mako(rt, p)
    update_wayfire(rt, p)

    if not no_reload:
        subprocess.run(["pkill", "-USR2", "-x", "waybar"], check=False)
        subprocess.run(["pkill", "-USR2", "-x", "plume-dock"], check=False)
        subprocess.run(["makoctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


if __name__ == "__main__":
    main()
