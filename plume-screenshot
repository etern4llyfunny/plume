#!/bin/sh
set -e
DIR="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")"
[ -d "$DIR" ] || DIR="$HOME"
mkdir -p "$DIR/Screenshots"
FILE="$DIR/Screenshots/plume-$(date +%Y%m%d-%H%M%S).png"

if [ "${1:-full}" = "area" ]; then
  GEOM="$(slurp -b '#13161c99' -c '#2f7fe6ff' -w 1)" || exit 0
  grim -g "$GEOM" "$FILE"
else
  grim "$FILE"
fi

wl-copy < "$FILE"
if command -v notify-send >/dev/null 2>&1; then
  notify-send "Plume" "Скриншот сохранён и скопирован: $(basename "$FILE")"
fi
